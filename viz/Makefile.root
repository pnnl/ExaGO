# Variables 
USERNAME := gradscaler
VERSION := V1.0.7
NETWORK := ${USERNAME}-network

# Frontend variables
FRONTEND_IMAGE := $(USERNAME)/westmap-frontend:$(VERSION)
FRONTEND_CONTAINER := westmap-frontend
FRONTEND_PORT := 8080

# Backend variables  
BACKEND_IMAGE := $(USERNAME)/westmap-backend:$(VERSION)
BACKEND_CONTAINER := westmap-backend
BACKEND_PORT := 5000

# Build all images
build-all: build-backend build-frontend

# Build frontend image
build-frontend:
	make build

# Build backend image
build-backend:
	cd backend && make build

# Create network (if not exists)
network: 
	docker network inspect $(NETWORK) >/dev/null 2>&1 || docker network create $(NETWORK)

# Run complete stack (backend -> frontend)
run-all: network run-backend wait-backend run-frontend

# Run backend only
run-backend:
	cd backend && make run

# Run frontend only
run-frontend:
	make run

# Wait for backend to be ready
wait-backend:
	@echo "Waiting for backend to be ready..."
	@timeout 60 bash -c 'until curl -f http://localhost:$(BACKEND_PORT)/health 2>/dev/null; do sleep 2; done' || echo "Backend might not be ready, continuing anyway..."

# Stop all containers
stop-all: stop-frontend stop-backend

# Stop frontend
stop-frontend:
	make clean

# Stop backend
stop-backend:
	cd backend && make clean

# Clean all containers
clean-all: stop-all

# Push all images
push-all: push-backend push-frontend

# Push frontend image
push-frontend:
	make push

# Push backend image
push-backend:
	cd backend && make push

# Show logs for all containers
logs-all:
	@echo "=== Backend Logs ==="
	@docker logs $(BACKEND_CONTAINER) --tail 50 || echo "Backend container not running"
	@echo ""
	@echo "=== Frontend Logs ==="
	@docker logs $(FRONTEND_CONTAINER) --tail 50 || echo "Frontend container not running"

# Show status of all containers
status:
	@echo "=== Container Status ==="
	@docker ps --filter "name=$(BACKEND_CONTAINER)" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
	@docker ps --filter "name=$(FRONTEND_CONTAINER)" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"

# Development helper - rebuild and restart everything
dev-restart: clean-all build-all run-all

.PHONY: build-all build-frontend build-backend network run-all run-backend run-frontend wait-backend stop-all stop-frontend stop-backend clean-all push-all push-frontend push-backend logs-all status dev-restart
